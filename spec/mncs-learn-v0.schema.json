{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-learn/spec/mncs-learn-v0.schema.json",
  "title": "MNCS Learn v0 bootstrap contracts",
  "description": "Transport-neutral bootstrap schema for machine-native learning contracts. This is not the final MNCS-language representation.",
  "oneOf": [
    { "$ref": "#/$defs/learning_event" },
    { "$ref": "#/$defs/learnable_capability" },
    { "$ref": "#/$defs/adaptation_proposal" },
    { "$ref": "#/$defs/fitness" },
    { "$ref": "#/$defs/evaluation" }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "producer": { "type": "string" },
        "revision": { "type": "string" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "rights": {
      "type": "object",
      "properties": {
        "inspect": { "type": "boolean" },
        "reason": { "type": "boolean" },
        "learn": { "type": "boolean" },
        "retain": { "type": "boolean" },
        "propagate": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": ["id", "kind", "data_type", "payload", "provenance", "confidence", "rights"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "data_type": { "type": "string", "minLength": 1 },
        "payload": {},
        "provenance": { "$ref": "#/$defs/provenance" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rights": { "$ref": "#/$defs/rights" },
        "observed_at": { "type": "string" },
        "features": { "type": "object" },
        "relationships": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "learning_event": {
      "type": "object",
      "required": ["schema", "kind", "id", "observation", "desired_effects", "context"],
      "properties": {
        "schema": { "const": "mncs.learn/0" },
        "kind": { "const": "learning_event" },
        "id": { "type": "string", "minLength": 1 },
        "observation": { "$ref": "#/$defs/observation" },
        "targets": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "desired_effects": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "context": { "type": "object" },
        "signals": {
          "type": "object",
          "properties": {
            "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
            "contradiction": { "type": "number", "minimum": 0, "maximum": 1 },
            "redundancy": { "type": "number", "minimum": 0, "maximum": 1 },
            "utility": { "type": "number" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "plasticity": {
      "type": "object",
      "required": ["current", "minimum", "maximum"],
      "properties": {
        "current": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 1 },
        "novelty_response": { "type": "number" },
        "contradiction_response": { "type": "number" },
        "maturity": { "type": "number", "minimum": 0, "maximum": 1 },
        "stability": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "learnable_capability": {
      "type": "object",
      "required": ["schema", "kind", "id", "model_id", "model_class", "accepts", "operators", "mutation_scopes", "timescales", "evaluation_dimensions", "plasticity"],
      "properties": {
        "schema": { "const": "mncs.learn/0" },
        "kind": { "const": "learnable_capability" },
        "id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_class": { "type": "string", "minLength": 1 },
        "accepts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "operators": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "mutation_scopes": {
          "type": "array",
          "items": { "enum": ["internal", "relationship", "topology", "routing"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "timescales": {
          "type": "array",
          "items": { "enum": ["fast", "consolidation", "evolution"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "evaluation_dimensions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "plasticity": { "$ref": "#/$defs/plasticity" },
        "constraints": { "type": "object" }
      },
      "additionalProperties": true
    },
    "adaptation_proposal": {
      "type": "object",
      "required": ["schema", "kind", "id", "event_id", "target_id", "operator", "mutation_scopes", "timescale", "reason", "expected_effect", "patch", "preconditions", "provenance"],
      "properties": {
        "schema": { "const": "mncs.learn/0" },
        "kind": { "const": "adaptation_proposal" },
        "id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "target_revision": { "type": "string" },
        "operator": { "type": "string", "minLength": 1 },
        "mutation_scopes": {
          "type": "array",
          "items": { "enum": ["internal", "relationship", "topology", "routing"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "timescale": { "enum": ["fast", "consolidation", "evolution"] },
        "reason": { "type": "string", "minLength": 1 },
        "expected_effect": { "type": "object" },
        "patch": { "type": "object" },
        "preconditions": { "type": "array", "items": { "type": "object" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "reversible": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "fitness": {
      "type": "object",
      "required": ["schema", "kind", "id", "dimensions", "constraints", "confidence"],
      "properties": {
        "schema": { "const": "mncs.learn/0" },
        "kind": { "const": "fitness" },
        "id": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "satisfied"],
            "properties": {
              "name": { "type": "string" },
              "satisfied": { "type": "boolean" },
              "detail": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": ["schema", "kind", "id", "proposal_id", "decision", "before", "after", "reasons"],
      "properties": {
        "schema": { "const": "mncs.learn/0" },
        "kind": { "const": "evaluation" },
        "id": { "type": "string", "minLength": 1 },
        "proposal_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["commit", "reject", "defer"] },
        "before": { "$ref": "#/$defs/fitness" },
        "after": { "$ref": "#/$defs/fitness" },
        "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": true
    }
  }
}
